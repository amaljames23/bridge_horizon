<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LoginTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#6366F1</item>
        <item name="hintTextColor">#9CA3AF</item>
        <item name="android:textColorHint">#9CA3AF</item>
        <item name="boxBackgroundColor">#1E1E1E</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>


    <style name="FilmTitleStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#121212</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="FilmGenreStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#9CA3AF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="FilmRatingStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#E0B1CB</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
